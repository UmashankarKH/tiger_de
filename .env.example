# Copy to .env. NEVER commit .env. In production use a secret manager, not a file.

# --- Claude agent (client/agent.py) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Which catalog the MCP server talks to: sqlite | unity | snowflake ---
CATALOG_BACKEND=sqlite
CATALOG_ALLOWED_SCHEMAS=cpg
CATALOG_MAX_SAMPLE_ROWS=5

# --- Databricks Unity Catalog (READ-ONLY service principal for the server) ---
# DATABRICKS_HOST=https://<workspace-hostname>
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# DATABRICKS_CATALOG=cpg_prod
# DATABRICKS_WAREHOUSE_ID=

# --- Snowflake (READ-ONLY role for the server, key-pair auth) ---
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PRIVATE_KEY_FILE=/secure/path/rsa_key.p8
# SNOWFLAKE_ROLE=CATALOG_MCP_READER
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_TAG_NAMESPACE=GOVERNANCE.TAGS

# --- Second lock for the human approval CLI only. Leave unset day to day. ---
# CATALOG_ALLOW_WRITE=1
